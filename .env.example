# Copy this file to ".env" and fill in real values.
# This template IS committed to Git, so it must never contain real secrets.
APP_NAME=API Key and Usage Metering Service
DATABASE_URL=postgresql+psycopg2://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/api_metering

# JWT settings
# Generate a secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
